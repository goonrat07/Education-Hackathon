# Copy to .env.local for local development. Never commit real values.

# Postgres. Locally: run `npm run db:start` and use this URL.
# On Vercel the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://studycoach:studycoach@localhost:5432/studycoach

# Sign-in. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally). Create an OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude. Server-side only. Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=
